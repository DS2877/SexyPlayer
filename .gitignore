# ─── Xcode ───────────────────────────────────────────────────────────────
# The .xcodeproj is generated by XcodeGen from project.yml — never commit it.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ─── Swift Package Manager ───────────────────────────────────────────────
.build/
.swiftpm/
Package.resolved
# …except the copy Xcode Cloud needs: ci_post_clone.sh seeds it into the
# generated .xcodeproj before the build resolves packages.
!ci_scripts/Package.resolved

# ─── Generated by XcodeGen ──────────────────────────────────────────────
Sources/App/Info.plist
Sources/App/Aeria.entitlements
Sources/TopShelf/Info.plist
Sources/TopShelf/AeriaTopShelf.entitlements

# ─── Secrets (never commit API keys) ────────────────────────────────────
Secrets.xcconfig
*.env
Config/Secrets*.plist

# ─── macOS / editor cruft ───────────────────────────────────────────────
.DS_Store
*.swp
.idea/
*.orig

# brand tooling
Tools/brand/node_modules/
Tools/brand/package*.json
